<odoo>
    <data>
    <record id="view_partner_form_csf_inherit" model="ir.ui.view">
        <field name="name">res.partner.form.csf.inherit</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='vat']" position="after">
                    <field name="csf_document_filename" invisible="1"/>
                    <field name="csf_document" filename="csf_document_filename"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>