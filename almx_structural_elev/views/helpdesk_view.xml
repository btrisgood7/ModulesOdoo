<odoo>
  <data>
    <record id="helpdesk_ticket_view_form_inherit" model="ir.ui.view">
      <field name="name">helpdesk.ticket.form.inherit.loan</field>
      <field name="model">helpdesk.ticket</field>
      <field name="inherit_id" ref="helpdesk.helpdesk_ticket_view_form"/>
      <field name="arch" type="xml">
        <xpath expr="//field[@name='priority']" position="after">
          <!--<group groups="almx_process_op.group_monitoring_process_op">-->
            <group attrs="{'invisible': [('team_id', '!=', 6)]}">
                <field name="start_date"/>
                <field name="effective_date"/>
                <field name="end_date"/>
            </group>
           <!-- </group>-->
        </xpath>
      </field>
    </record>
  </data>
</odoo>