<odoo>
  <data>
    <record id="approval_request_view_form_inherit" model="ir.ui.view">
      <field name="name">approval.request.form.inherit.loan</field>
      <field name="model">approval.request</field>
      <field name="inherit_id" ref="approvals.approval_request_view_form"/>
      <field name="arch" type="xml">
        <xpath expr="//field[@name='location']" position="after">
            <group groups="almx_process_op.group_monitoring_process_op">
            <field name="in_process_request"/>
            <field name="out_process_request"/>
            <field name="process_reason"
                   attrs="{'invisible': [('out_process_request','=',False)],
                           'required': [('out_process_request','=',True)]}"/>
            </group>
        </xpath>
      </field>
    </record>
  </data>
</odoo>